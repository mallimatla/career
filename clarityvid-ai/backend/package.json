{
  "name": "clarityvid-ai-backend",
  "version": "2.0.0",
  "description": "ClarityVid AI - Complete Content Generation Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test jest --coverage --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:unit": "NODE_ENV=test jest tests/unit --coverage",
    "test:integration": "NODE_ENV=test jest tests/integration --coverage",
    "migrate": "node src/utils/migrate.js",
    "seed": "node src/utils/seed.js",
    "worker": "node src/workers/videoProcessor.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/workers/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": ["./tests/setup.js"]
  },
  "keywords": [
    "ai",
    "video",
    "presentation",
    "document",
    "website",
    "generation"
  ],
  "author": "ClarityVid AI Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1498.0",
    "stripe": "^14.7.0",
    "bull": "^4.12.0",
    "redis": "^4.6.11",
    "axios": "^1.6.2",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "officegen": "^0.6.5",
    "jsdom": "^23.0.1",
    "marked": "^11.0.0",
    "google-tts-api": "^2.0.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "canvas": "^2.11.2",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.0",
    "cron": "^3.1.6",
    "puppeteer": "^21.6.1",
    "pptxgenjs": "^3.12.0",
    "docx": "^8.5.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
