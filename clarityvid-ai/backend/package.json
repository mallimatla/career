{
  "name": "clarityvid-ai-backend",
  "version": "2.0.0",
  "description": "ClarityVid AI - Complete Content Generation Platform Backend",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:all": "firebase deploy",
    "logs": "firebase functions:log",
    "dev": "firebase emulators:start",
    "test": "NODE_ENV=test jest --coverage --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:unit": "NODE_ENV=test jest tests/unit --coverage",
    "test:integration": "NODE_ENV=test jest tests/integration --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/workers/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": ["./tests/setup.js"]
  },
  "keywords": [
    "ai",
    "video",
    "presentation",
    "document",
    "website",
    "generation"
  ],
  "author": "ClarityVid AI Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.2",
    "@anthropic-ai/sdk": "^0.9.1",
    "bull": "^4.12.0",
    "redis": "^4.6.11",
    "axios": "^1.6.2",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "officegen": "^0.6.5",
    "jsdom": "^23.0.1",
    "marked": "^11.0.0",
    "google-tts-api": "^2.0.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "canvas": "^2.11.2",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.0",
    "cron": "^3.1.6",
    "puppeteer": "^21.6.1",
    "pptxgenjs": "^3.12.0",
    "docx": "^8.5.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
